# Auth — must match the X-API-Key header in every request
MNEMO_API_KEY=your-secret-key-here

# LLM (NVIDIA NIM) — structured fact extraction
NVIDIA_API_KEY=nvapi-your_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
EXTRACTION_MODEL=z-ai/glm-5.2
# Optional fallbacks
GROQ_API_KEY=
OPENAI_API_KEY=

# Embeddings (Ollama on host, or OpenAI)
EMBEDDING_MODEL=nomic-embed-text
# Local uvicorn: localhost. Docker Compose: host.docker.internal
EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1

# Storage
DATABASE_URL=sqlite+aiosqlite:///./mnemo.db

# --- Local dev (uvicorn on host) ---
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- Docker Compose (service hostnames) ---
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333

# Extraction
EXTRACTION_MODE=sync
EXTRACTION_CONCURRENCY=5

# Retrieval
DEFAULT_TOKEN_BUDGET=1500
DEFAULT_SEARCH_LIMIT=20

# Retention — hard-delete retracted facts after N days (nightly ARQ job)
RETRACTED_FACT_RETENTION_DAYS=30
