# Auth — must match the X-API-Key header in every request
MNEMO_API_KEY=your-secret-key-here

# LLM (Groq) — used for structured fact re-extraction
OPENAI_API_KEY=gsk_...
GROQ_API_KEY=
EXTRACTION_MODEL=llama-3.3-70b-versatile

# Embeddings (Ollama on host, or OpenAI)
EMBEDDING_MODEL=nomic-embed-text

# Storage
DATABASE_URL=sqlite+aiosqlite:///./mnemo.db

# --- Local dev (uvicorn on host) ---
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- Docker Compose (service hostnames) ---
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333

# Extraction
EXTRACTION_MODE=sync
EXTRACTION_CONCURRENCY=5

# Retrieval
DEFAULT_TOKEN_BUDGET=1500
DEFAULT_SEARCH_LIMIT=20
